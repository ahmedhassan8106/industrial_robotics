#include <math.h>
#include <signal.h>
#include <stdio.h>
#include <string.h>

#include "rcl/rcl.h"
#include "rcl/time.h"
#include "rclc/rclc.h"
#include "rclc/executor.h"

#include "sensor_msgs/msg/joint_state.h"
#include "std_msgs/msg/float64.h"

#define JOINT_COUNT 7

static volatile sig_atomic_t running = 1;

static rcl_publisher_t publishers[JOINT_COUNT];

static const char *joint_names[JOINT_COUNT] = {
    "joint_1",
    "joint_2",
    "joint_3",
    "joint_4",
    "joint_5",
    "joint_6",
    "joint_7"
};

static const char *command_topics[JOINT_COUNT] = {
    "/joint_1/cmd_pos",
    "/joint_2/cmd_pos",
    "/joint_3/cmd_pos",
    "/joint_4/cmd_pos",
    "/joint_5/cmd_pos",
    "/joint_6/cmd_pos",
    "/joint_7/cmd_pos"
};

static const double lower_limits[JOINT_COUNT] = {
    -3.1416,
    -1.5708,
    -2.0944,
    -3.1416,
    -1.5708,
     0.0,
    -0.5236
};

static const double upper_limits[JOINT_COUNT] = {
     3.1416,
     1.5708,
     2.0944,
     3.1416,
     1.5708,
     0.5236,
     0.0
};

static void signal_handler(int signal_number)
{
    (void)signal_number;
    running = 0;
}

static void joint_target_callback(const void *message)
{
    if (message == NULL) {
        return;
    }

    const sensor_msgs__msg__JointState *targets =
        (const sensor_msgs__msg__JointState *)message;

    if (targets->name.size != targets->position.size) {
        return;
    }

    for (size_t i = 0; i < targets->name.size; i++) {

        const char *name = targets->name.data[i].data;
        double position = targets->position.data[i];

        if (name == NULL || !isfinite(position)) {
            continue;
        }

        for (size_t j = 0; j < JOINT_COUNT; j++) {

            if (strcmp(name, joint_names[j]) == 0) {

                if (position < lower_limits[j]) {
                    position = lower_limits[j];
                }

                if (position > upper_limits[j]) {
                    position = upper_limits[j];
                }

                std_msgs__msg__Float64 command = {0};
                command.data = position;

                rcl_publish(
                    &publishers[j],
                    &command,
                    NULL
                );

                break;
            }
        }
    }
}

int main(int argc, const char *argv[])
{
    signal(SIGINT, signal_handler);
    signal(SIGTERM, signal_handler);

    rcl_allocator_t allocator = rcl_get_default_allocator();

    rclc_support_t support;

    if (rclc_support_init(
            &support, argc, argv, &allocator) != RCL_RET_OK) {
        fprintf(stderr, "Failed to initialize ROS 2\n");
        return 1;
    }

    rcl_node_t node = rcl_get_zero_initialized_node();

    if (rclc_node_init_default(
            &node,
            "slider_to_gazebo_c",
            "",
            &support) != RCL_RET_OK) {
        fprintf(stderr, "Failed to create node\n");
        return 1;
    }

    for (size_t i = 0; i < JOINT_COUNT; i++) {

        publishers[i] = rcl_get_zero_initialized_publisher();

        if (rclc_publisher_init_default(
                &publishers[i],
                &node,
                ROSIDL_GET_MSG_TYPE_SUPPORT(
                    std_msgs, msg, Float64),
                command_topics[i]) != RCL_RET_OK) {
            fprintf(stderr, "Failed to create publisher\n");
            return 1;
        }
    }

    rcl_subscription_t subscription =
        rcl_get_zero_initialized_subscription();

    if (rclc_subscription_init_default(
            &subscription,
            &node,
            ROSIDL_GET_MSG_TYPE_SUPPORT(
                sensor_msgs, msg, JointState),
            "/slider_joint_targets") != RCL_RET_OK) {
        fprintf(stderr, "Failed to create subscription\n");
        return 1;
    }

    sensor_msgs__msg__JointState input_message;

    if (!sensor_msgs__msg__JointState__init(&input_message)) {
        fprintf(stderr, "Failed to initialize message\n");
        return 1;
    }

    rclc_executor_t executor =
        rclc_executor_get_zero_initialized_executor();

    if (rclc_executor_init(
            &executor,
            &support.context,
            1,
            &allocator) != RCL_RET_OK) {
        fprintf(stderr, "Failed to initialize executor\n");
        return 1;
    }

    if (rclc_executor_add_subscription(
            &executor,
            &subscription,
            &input_message,
            joint_target_callback,
            ON_NEW_DATA) != RCL_RET_OK) {
        fprintf(stderr, "Failed to add subscription\n");
        return 1;
    }

    printf("C joint controller started.\n");
    printf("Listening on /slider_joint_targets\n");
    fflush(stdout);

    while (running && rcl_context_is_valid(&support.context)) {
        rclc_executor_spin_some(
            &executor,
            RCL_MS_TO_NS(100)
        );
    }

    rclc_executor_fini(&executor);

    rcl_subscription_fini(&subscription, &node);

    for (size_t i = 0; i < JOINT_COUNT; i++) {
        rcl_publisher_fini(&publishers[i], &node);
    }

    sensor_msgs__msg__JointState__fini(&input_message);

    rcl_node_fini(&node);
    rclc_support_fini(&support);

    return 0;
}
