<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="simulation">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import simulation urdf file -->
    <xacro:include filename="$(find robot_c)/urdf/simulation.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="simulation.ros2_control.xacro" />


    <xacro:simulation_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
